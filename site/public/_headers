# En-têtes des fichiers statiques (Cloudflare Pages). Les réponses de l'API viennent des Functions, qui posent les leurs.
# CSP sans 'unsafe-eval' ni 'unsafe-inline' : l'interface utilise la version d'exécution de Vue (fonctions de rendu,
# aucun gabarit compilé dans le navigateur) et ne pose les styles que par le CSSOM (variables CSS).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://upload.wikimedia.org https://thumb.wikimedia.org; connect-src 'self' https://fr.wikipedia.org https://www.wikidata.org https://query.wikidata.org; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# App installée : le service worker et le manifeste sont toujours revalidés (une version figée du service worker
# garderait une vieille interface) ; Service-Worker-Allowed n'est pas utile (sw.js est à la racine). Le service worker a
# sa propre CSP (« ! » retire celle de /*) : ses fetch() vers Vue et les polices passent par connect-src.
/sw.js
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; connect-src 'self' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com
  Cache-Control: no-cache
  Content-Type: text/javascript; charset=utf-8

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json; charset=utf-8
