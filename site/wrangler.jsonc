// Déploiement comme Worker Cloudflare (« Workers Builds » relié à la branche wikimasters, dossier racine `site`,
// commande de déploiement `npx wrangler deploy`). Voir SETUP.md. Un projet Pages ignore ce fichier.
{
  // Doit être exactement le nom du Worker créé dans le tableau de bord Cloudflare.
  "name": "classeur-wm",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // Fichiers statiques : public/ seulement (jamais functions/, schema.sql ni SPEC.md). /api/* passe par le Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // La base D1 « classeur » : database_id = l'identifiant affiché sur sa page (Storage & Databases, D1).
  "d1_databases": [
    { "binding": "DB", "database_name": "classeur", "database_id": "f5a592f3-e7fa-42f3-a65f-40a2dce56449" }
  ],
  // Garde les variables posées dans le tableau de bord (MAX_USERS…) ; les secrets (COOKIE_SECRET, SIGNUP_CODE)
  // ne sont jamais touchés par un déploiement.
  "keep_vars": true,
  // Marché entier lu avec la session de ce compte du jeu seulement (marketscan.js, demande de son propriétaire, 2026-10-29) ;
  // retirer la ligne pour couper (une valeur posée dans le tableau de bord serait écrasée à chaque déploiement).
  "vars": { "MARKET_SCAN_PSEUDO": "Djodjino" },
  "observability": { "enabled": true },
  // Lectures automatiques (cron.js) : la collection toutes les 10 minutes, le marché toutes les 20 minutes (décalé de 5).
  "triggers": { "crons": ["*/10 * * * *", "5-59/20 * * * *"] }
}
