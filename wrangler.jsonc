// Même configuration que site/wrangler.jsonc, pour un Worker dont le dossier racine (Root directory) est la racine
// de la branche au lieu de `site` : wrangler la trouve dans les deux cas. Garder les deux fichiers identiques
// (à part les chemins).
{
  "name": "classeur-wm",
  "main": "site/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./site/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "classeur", "database_id": "f5a592f3-e7fa-42f3-a65f-40a2dce56449" }
  ],
  "keep_vars": true,
  "observability": { "enabled": true },
  // Lectures automatiques (cron.js) : la collection toutes les 10 minutes, le marché toutes les 20 minutes (décalé de 5).
  "triggers": { "crons": ["*/10 * * * *", "5-59/20 * * * *"] }
}
